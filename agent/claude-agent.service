[Unit]
Description=Claude email/Drive agent (drafts replies, never sends)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=claudeagent
Group=claudeagent
EnvironmentFile=/etc/claude-agent/env
WorkingDirectory=/opt/claude-agent
ExecStart=/opt/claude-agent/venv/bin/python /opt/claude-agent/run_agent.py

# --- hardening: this service should touch almost nothing on the box ---
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/claude-agent
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=false
# Only outbound network needed; no listening sockets.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
