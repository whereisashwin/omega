# Copy to ~/.claude-mcp.env  (chmod 600).  NEVER commit real values.
# Leave a block blank to skip registering that MCP server.

# --- Anthropic auth (optional here; you can also log in interactively) ---
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME

# --- Google Workspace MCP (Gmail + Drive) ---
# Desktop OAuth client with Gmail API + Drive API enabled; add yourself as test user.
GOOGLE_OAUTH_CLIENT_ID=REPLACE_ME.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=REPLACE_ME

# --- GitHub MCP ---
# Fine-grained personal access token, limited to the repos you want the agent to touch.
GITHUB_PAT=github_pat_REPLACE_ME
