# Copy to /etc/claude-agent/env  (chmod 600, owned by claudeagent).
# NEVER commit real values.

# --- Anthropic ---
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME

# --- Google OAuth (Desktop client with Gmail API + Drive API enabled) ---
GOOGLE_OAUTH_CLIENT_ID=REPLACE_ME.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=REPLACE_ME

# --- Agent behaviour ---
# How many recent unread threads to consider per run.
AGENT_MAX_THREADS=5
# Model to use.
AGENT_MODEL=claude-sonnet-5
# Where the google workspace MCP caches its OAuth token (must be writable by claudeagent).
GOOGLE_MCP_CREDENTIALS_DIR=/opt/claude-agent/.google-mcp
